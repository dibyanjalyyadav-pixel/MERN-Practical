Eligibility.jsx
function Eligibility() {
    const totalGradePoints = 80;
    const totalSubjects = 9;
    const cgpa = totalGradePoints / totalSubjects;


    const totalClasses = 60;
    const attendedClasses = 59;
    const attendance = (attendedClasses / totalClasses) * 100;


    const minCGPA = 7;
    const minAttendance = 75;
    const status =
        cgpa >= minCGPA && attendance >= minAttendance
            ? "Eligible"
            : "Not Eligible";
    return (
        <div>
            <h2>Placement Eligibility</h2>
            <p>Minimum CGPA Required: {minCGPA}</p>
            <p>Minimum Attendance: {minAttendance}%</p>
            <p>Status: {status}</p>
        </div>
    );
}
export default Eligibility;


Placementstatus.jsx
function Placementstatus() {


    const totalStudents = 180;
    const placedStudents = 142;


    const remainingStudents = totalStudents - placedStudents;
    const placementPercentage = (placedStudents / totalStudents) * 100;
    return (
        <div>
            <h2>Placement Statistics</h2>
            <p>Total Students: {totalStudents}</p>
            <p>Placed Students: {placedStudents}</p>
            <p>Remaining Students: {remainingStudents}</p>
            <p>Placement Percentage: {placementPercentage.toFixed(2)}%</p>
        </div>
    );
}
export default Placementstatus;


