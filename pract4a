function Skillprogress() {
    const totalSkills = 12;
    const completedSkills = 9;
    const pendingSkills = totalSkills - completedSkills;


    const progress = (completedSkills / totalSkills) * 100;
    return (
        <div>
            <h2>Skill Progress</h2>
            <p>Total Skills: {totalSkills}</p>
            <p>Completed Skills: {completedSkills}</p>
            <p>Pending Skills: {pendingSkills}</p>
            <p>Progress: {progress.toFixed(2)}%</p>
        </div>
    );
}
export default Skillprogress;


